# Never commit personal contact data.
# All contact-bearing formats are ignored everywhere; only the curated,
# synthetic sample/sample_*.vcf fixtures are allowed back in.
backup/
*.vcf
*.csv
*.json
*.vcards
*.ics
*.abbu
!sample/sample_*.vcf

# Allow the GUI's package manifests (the *.json rule above is for snapshot data)
!gui/package.json
!gui/package-lock.json

# Python
.venv/
__pycache__/
*.pyc

# Node / Electron
node_modules/
gui/dist/
gui/out/

# macOS
.DS_Store
