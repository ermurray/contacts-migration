{
  "name": "contacts-migration-gui",
  "productName": "Contacts Migration",
  "version": "1.0.0-alpha.2",
  "description": "Cross-platform GUI to migrate iCloud contacts between accounts with verified backup and gated deletion",
  "author": "Symbi <eric@symbi.tech>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ermurray/contacts-migration.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/selftest.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tech.symbi.contacts-migration",
    "directories": { "output": "dist" },
    "afterPack": "./build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "title": "Contacts Migration"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "maintainer": "Symbi <eric@symbi.tech>"
    }
  }
}
